# ─────────────────────────────────────────────────────────────
# StayZone environment variables
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local — it contains secrets.
# ─────────────────────────────────────────────────────────────

# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# The "publishable" key (older projects call it the "anon" key). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# The "secret" key (older projects: "service_role"). SERVER ONLY. Never expose it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Your site's public address (no trailing slash). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brand (change any time without touching code)
NEXT_PUBLIC_BRAND_NAME=StayZone
NEXT_PUBLIC_BRAND_NAME_UR=اسٹے زون
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Demo mode: "true" shows listings flagged as demo (with a "Demo listing" badge)
# and a preview banner. If left empty AND no Supabase keys are set, the site runs
# from the built-in demo catalogue automatically. MUST be "false" for the real launch.
NEXT_PUBLIC_DEMO_MODE=false

# Optional: Mapbox static maps. Without it, OpenStreetMap is used.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional social links shown in the footer
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_TIKTOK=

# Only for running database tests locally (see README → Testing)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/stayzone_test
